<!-- res/layout/patient_info_popup.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/popup_background"
    android:layout_gravity="center"
    android:elevation="8dp">

<!--    error massgae-->
<!--    <TextView-->
<!--        android:id="@+id/errorMessageTextView"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:text="Please check the input fields and try again."-->
<!--        android:textColor="#FF0000"-->
<!--        android:visibility="gone"-->
<!--        android:paddingTop="12dp"/>-->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Patient Information"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_gravity="center"
        android:paddingBottom="12dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        android:layout_marginBottom="16dp"/>

    <!-- Research Code Field -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mã nghiên cứu"
        android:textColor="#000000"
        android:textSize="16sp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/researchCodeEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="00EIa"
        android:background="@drawable/edit_text_background"
        android:padding="12dp"
        android:inputType="text"
        android:layout_marginBottom="12dp"/>

    <!-- Location Code Field -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mã địa điểm"
        android:textColor="#000000"
        android:textSize="16sp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/locationCodeEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="003"
        android:background="@drawable/edit_text_background"
        android:padding="12dp"
        android:inputType="number"
        android:layout_marginBottom="12dp"/>

    <!-- Serial Number Field -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STT trong NC"
        android:textColor="#000000"
        android:textSize="16sp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/serialNumberEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="0000"
        android:background="@drawable/edit_text_background"
        android:padding="12dp"
        android:inputType="text"
        android:layout_marginBottom="20dp"/>

    <!-- Submit Button -->
    <Button
        android:id="@+id/submitButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Submit"
        android:backgroundTint="#00FF9C"
        android:textColor="@android:color/white"
        android:padding="10dp"
        android:textStyle="bold"/>
</LinearLayout>
