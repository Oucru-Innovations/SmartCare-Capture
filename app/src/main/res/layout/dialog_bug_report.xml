<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/bug_report_log_files_label" />

    <ListView
        android:id="@+id/list_bug_report_log_files"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginBottom="12dp"
        android:choiceMode="multipleChoice"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/text_bug_report_no_logs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/bug_report_no_logs"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/bug_report_hint_label" />

    <EditText
        android:id="@+id/edit_bug_report_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:hint="@string/bug_report_hint"
        android:inputType="textMultiLine"
        android:maxLines="8"
        android:minLines="4" />

</LinearLayout>
