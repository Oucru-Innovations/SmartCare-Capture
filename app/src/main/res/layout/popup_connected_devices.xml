    <!-- res/layout/connected_devices_layout.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/popup_background"> <!-- Apply rounded background -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Danh sách thiết bị"
        android:textSize="18sp"
        android:textColor="#333333"
        android:layout_marginBottom="12dp"
        android:fontFamily="sans-serif-medium"/>

    <!-- First device layout with drawable background for TextView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp"
        android:padding="8dp"
        android:background="@drawable/edit_text_background"> <!-- Adds border and rounded corners -->

        <TextView
            android:id="@+id/connectedMac"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:padding="8dp"
            android:textColor="#666666" />

        <ImageButton
            android:id="@+id/device1Delete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="@null"
            android:tint="@android:color/holo_red_dark"
            android:contentDescription="Xóa thiết bị 1" />
    </LinearLayout>

    <!-- Second device layout with drawable background for TextView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@drawable/edit_text_background"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/queuedMac"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:padding="8dp"
            android:textColor="#666666" />

        <ImageButton
            android:id="@+id/device2Delete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="@null"
            android:tint="@android:color/holo_red_dark"
            android:contentDescription="Xóa thiết bị 2" />
    </LinearLayout>

    <Button
        android:id="@+id/scanNewDeviceBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quét thiết bị mới"
        android:textColor="@android:color/white"
        android:backgroundTint="#FF9800"
        android:layout_marginTop="8dp"/>

    <ListView
        android:id="@+id/scannedDevicesList"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:visibility="gone"
        android:layout_marginTop="8dp"/>

</LinearLayout>
