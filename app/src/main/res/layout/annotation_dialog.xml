<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Template Selector -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Template"
        android:layout_marginBottom="8dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioGroup
                android:id="@+id/template_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/template_log_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/annotation_selector_bg"
                    android:button="@null"
                    android:checked="true"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="Log"
                    android:textAlignment="center" />

                <RadioButton
                    android:id="@+id/template_model_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/annotation_selector_bg"
                    android:button="@null"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="Model"
                    android:textAlignment="center" />

<!--                <RadioButton-->
<!--                    android:id="@+id/template_task_list"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:background="@drawable/annotation_selector_bg"-->
<!--                    android:button="@null"-->
<!--                    android:paddingStart="12dp"-->
<!--                    android:paddingTop="8dp"-->
<!--                    android:paddingEnd="12dp"-->
<!--                    android:paddingBottom="8dp"-->
<!--                    android:text="Task List"-->
<!--                    android:textAlignment="center" />-->
            </RadioGroup>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Template Content Container -->
    <ViewFlipper
        android:id="@+id/template_content_flipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Quick Note Template (existing layout) -->
        <include
            android:id="@+id/template_quick_note_content"
            layout="@layout/template_log_note" />

        <!-- Meeting Template -->
        <include
            android:id="@+id/template_meeting_content"
            layout="@layout/template_model_note" />

        <!-- Add more note below (create new template) -->
<!--        <include-->
<!--            android:id="@+id/template_task_list_content"-->
<!--            layout="@layout/template_task_list" />-->
    </ViewFlipper>
</LinearLayout>