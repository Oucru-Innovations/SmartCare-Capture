<resources>
    <style name="CustomTheme" parent="@android:style/Theme.Holo.Light.DarkActionBar">
        <item name="android:actionBarStyle">@style/MyActionBar</item>
        <item name="android:itemTextAppearance">@style/MyMenuText</item>
        <item name="android:textColorPrimary">#000000</item>
        <!-- Custom overflow button -->
        <item name="android:actionOverflowButtonStyle">@style/MyOverflowButton</item>
    </style>

    <style name="MyActionBar" parent="@android:style/Widget.Holo.Light.ActionBar">
        <item name="android:background">#1976D2</item>
    </style>

    <style name="MyMenuText" parent="@android:style/TextAppearance.Holo.Widget.ActionBar.Menu">
        <item name="android:textColor">#3DC2EC</item> <!-- Change this to your desired color -->
    </style>

    <!-- Custom style for the overflow button -->
    <style name="MyOverflowButton" parent="@android:style/Widget.Holo.ActionButton.Overflow">
        <item name="android:src">@drawable/ic_hamburger_menu</item>
    </style>
</resources>